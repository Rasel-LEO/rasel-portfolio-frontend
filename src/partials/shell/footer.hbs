{{!-- Author: Rasel Al Mamun --}}
{{!-- Footer (FD-94, FD-139), every page: brand block (the Ideatrium signature); Explore, Research profiles and Connect; a rule;
the copyright (build year), the AI-portrait note, the Privacy Policy link (FD-143) and the Theme button. External links open in a new tab and say so.
The bottom row keeps the back-to-top photo's slot free (FD-95, FD-104). --}}
<footer class="site-footer">
  <div class="container">
    <div class="row site-footer-main">
      <div class="col-12 col-lg-4 footer-brand">
        {{!-- FD-139: the signature form — the logo, then "by Rasel Al Mamun" as real text; the link
        names the site and the author for people and search engines alike. --}}
        <a class="footer-signature" href="/index.html"{{{ariaCurrent "home"}}}>{{> icons/logo class="footer-logo" width="220" height="32"}}<span class="visually-hidden">Ideatrium </span><span class="footer-by">{{footer.signature_by}}</span></a>
        {{!-- FD-148: the role line is the hero's (profile.role_line), one value for both. --}}
        {{#if profile.role_line}}<p class="footer-role mb-0">{{{dots profile.role_line}}}</p>{{/if}}
        <p class="footer-affiliation mb-0">
          {{#each footerAffiliation}}<span class="d-block">{{this}}</span>{{/each}}
        </p>
        {{!-- FD-155: both addresses in one tight group, one envelope icon. --}}
        {{#if (or profile.email profile.secondary_email)}}
        <div class="footer-emails">
          {{> icons/footer-icon name="mail"}}
          <ul class="list-unstyled mb-0">
            {{#if profile.email}}<li><a class="footer-email" href="mailto:{{profile.email}}" aria-label="Email {{profile.email}}"><span class="link">{{profile.email}}</span></a></li>{{/if}}
            {{#if profile.secondary_email}}<li><a class="footer-email footer-email-2" href="mailto:{{profile.secondary_email}}" aria-label="Email {{profile.secondary_email}}"><span class="link">{{profile.secondary_email}}</span></a></li>{{/if}}
          </ul>
        </div>
        {{/if}}
      </div>

      <nav class="col-5 col-lg-2 offset-lg-1 footer-group" aria-labelledby="footer-explore">
        <p class="footer-group-title mb-0" id="footer-explore">{{footer.groups.explore}}</p>
        <ul class="list-unstyled mb-0">
          <li><a class="footer-link" href="/portfolio.html"{{{ariaCurrent "portfolio"}}}>{{> icons/footer-icon name="portfolio"}}<span class="link">Portfolio</span></a></li>
          <li><a class="footer-link" href="/blog.html"{{{ariaCurrent "blog"}}}>{{> icons/footer-icon name="blog"}}<span class="link">Blog</span></a></li>
          <li><a class="footer-link" href="/hire.html"{{{ariaCurrent "hire"}}}>{{> icons/footer-icon name="hire"}}<span class="link">Hire me</span></a></li>
          <li><a class="footer-link" href="/contact.html"{{{ariaCurrent "contact"}}}>{{> icons/footer-icon name="contact"}}<span class="link">Contact</span></a></li>
        </ul>
      </nav>

      {{#if footerLinks.research.length}}
      <nav class="col-7 col-lg-3 footer-group" aria-labelledby="footer-research">
        <p class="footer-group-title mb-0" id="footer-research">{{footer.groups.research}}</p>
        <ul class="list-unstyled mb-0">
          {{#each footerLinks.research}}
          <li><a class="footer-link" href="{{url}}" target="_blank" rel="me noopener noreferrer">{{> icons/footer-icon name=id}}<span class="link">{{label}}</span><span class="visually-hidden">(opens in a new tab)</span><svg class="icon footer-external" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false"><path d="M7 17L17 7M9 7h8v8" /></svg></a></li>
          {{/each}}
        </ul>
      </nav>
      {{/if}}

      {{#if footerLinks.connect.length}}
      <nav class="col-12 col-lg-2 footer-group footer-connect" aria-labelledby="footer-connect">
        <p class="footer-group-title mb-0" id="footer-connect">{{footer.groups.connect}}</p>
        <ul class="list-unstyled mb-0">
          {{#each footerLinks.connect}}
          <li><a class="footer-link" href="{{url}}" target="_blank" rel="me noopener noreferrer">{{> icons/footer-icon name=id}}<span class="link">{{label}}</span><span class="visually-hidden">(opens in a new tab)</span><svg class="icon footer-external" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false"><path d="M7 17L17 7M9 7h8v8" /></svg></a></li>
          {{/each}}
        </ul>
      </nav>
      {{/if}}
    </div>

    <div class="site-footer-bottom">
      <div class="footer-legal">
        <p class="footer-copyright mb-0">© {{buildYear}} {{footer.copyright_name}}</p>
        {{!-- FD-143: the Privacy Policy on every page; Django: {% url 'privacy' %} (/privacy/). --}}
        <p class="footer-privacy mb-0"><a class="footer-link footer-privacy-link" href="/privacy.html"{{{ariaCurrent "privacy"}}}><span class="link">{{privacy.link_label}}</span></a></p>
      </div>
      {{> components/theme-button class="footer-theme"}}
    </div>
  </div>
</footer>
