{{!-- Author: Rasel Al Mamun --}}
{{!-- Footer (FD-94), every page: brand block; Explore, Research profiles and Connect; a rule;
the copyright (build year) and the Theme button. External links open in a new tab and say so.
The bottom row keeps the back-to-top photo's slot free (FD-95, FD-104). --}}
<footer class="site-footer">
  <div class="container">
    <div class="row site-footer-main">
      <div class="col-12 col-lg-4 footer-brand">
        <p class="footer-name mb-0">{{profile.name}}</p>
        <p class="footer-role mb-0">{{footer.role_line}}</p>
        <p class="footer-affiliation mb-0">
          {{#each footerAffiliation}}<span class="d-block">{{this}}</span>{{/each}}
        </p>
        <a class="footer-link footer-email" href="mailto:{{profile.email}}">{{> icons/footer-icon name="mail"}}<span class="link">{{profile.email}}</span></a>
      </div>

      <nav class="col-5 col-lg-2 offset-lg-1 footer-group" aria-labelledby="footer-explore">
        <p class="footer-group-title mb-0" id="footer-explore">{{footer.groups.explore}}</p>
        <ul class="list-unstyled mb-0">
          <li><a class="footer-link" href="/portfolio.html"{{{ariaCurrent "portfolio"}}}>{{> icons/footer-icon name="portfolio"}}<span class="link">Portfolio</span></a></li>
          <li><a class="footer-link" href="/blog.html"{{{ariaCurrent "blog"}}}>{{> icons/footer-icon name="blog"}}<span class="link">Blog</span></a></li>
          <li><a class="footer-link" href="/hire.html"{{{ariaCurrent "hire"}}}>{{> icons/footer-icon name="hire"}}<span class="link">Hire me</span></a></li>
          <li><a class="footer-link" href="/contact.html"{{{ariaCurrent "contact"}}}>{{> icons/footer-icon name="contact"}}<span class="link">Contact</span></a></li>
        </ul>
      </nav>

      <nav class="col-7 col-lg-3 footer-group" aria-labelledby="footer-research">
        <p class="footer-group-title mb-0" id="footer-research">{{footer.groups.research}}</p>
        <ul class="list-unstyled mb-0">
          {{#each footerLinks.research}}
          <li><a class="footer-link" href="{{url}}" target="_blank" rel="me noopener noreferrer">{{> icons/footer-icon name=id}}<span class="link">{{label}}</span><span class="visually-hidden">(opens in a new tab)</span><svg class="icon footer-external" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false"><path d="M7 17L17 7M9 7h8v8" /></svg></a></li>
          {{/each}}
        </ul>
      </nav>

      <nav class="col-12 col-lg-2 footer-group footer-connect" aria-labelledby="footer-connect">
        <p class="footer-group-title mb-0" id="footer-connect">{{footer.groups.connect}}</p>
        <ul class="list-unstyled mb-0">
          {{#each footerLinks.connect}}
          <li><a class="footer-link" href="{{url}}" target="_blank" rel="me noopener noreferrer">{{> icons/footer-icon name=id}}<span class="link">{{label}}</span><span class="visually-hidden">(opens in a new tab)</span><svg class="icon footer-external" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false"><path d="M7 17L17 7M9 7h8v8" /></svg></a></li>
          {{/each}}
        </ul>
      </nav>
    </div>

    <div class="site-footer-bottom">
      <p class="footer-copyright mb-0">© {{buildYear}} {{footer.copyright_name}}</p>
      <button type="button" class="btn btn-secondary footer-theme js-only" data-theme-toggle aria-label="Theme: dark"><svg class="icon icon-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg><svg class="icon icon-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>Theme</button>
    </div>
  </div>
</footer>
