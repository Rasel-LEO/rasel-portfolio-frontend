{{!-- Author: Rasel Al Mamun --}}
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="container site-header-bar">
    <a class="brand" href="/index.html" data-brand{{{ariaCurrent "home"}}}>
      <span class="brand-mark">
        <picture>
          <source type="image/avif" srcset="/images/avatar/avatar-96.avif" />
          <img src="/images/avatar/avatar-96.webp" alt="" width="28" height="28" loading="eager" decoding="sync" />
        </picture>
      </span>
      <span class="brand-name">{{profile.name}}</span>
    </a>
    <nav class="site-nav d-none d-lg-block" aria-label="Primary">
      <ul class="list-unstyled d-flex gap-1 mb-0">
        <li><a href="/portfolio.html"{{{ariaCurrent "portfolio"}}}>Portfolio</a></li>
        <li><a href="/blog.html"{{{ariaCurrent "blog"}}}>Blog</a></li>
        <li><a href="/contact.html"{{{ariaCurrent "contact"}}}>Contact</a></li>
      </ul>
    </nav>
    <div class="site-header-tools">
      <a class="btn btn-primary btn-sm hire-cta" href="/hire.html"{{{ariaCurrent "hire"}}}>
        <span class="hire-cta-text">Hire me</span>
        <svg class="icon icon-arrow" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
      <button type="button" class="btn btn-icon theme-toggle js-only" data-theme-toggle aria-label="Theme: dark" title="Theme">
        <svg class="icon icon-moon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
        <svg class="icon icon-sun" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        <span class="btn-icon-label d-none d-lg-inline-block" aria-hidden="true" data-theme-state>Dark</span>
      </button>
      <button type="button" class="btn btn-icon menu-button d-lg-none js-only" data-menu-button aria-expanded="false" aria-controls="drawer" aria-label="Menu">
        <svg class="icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>
</header>
