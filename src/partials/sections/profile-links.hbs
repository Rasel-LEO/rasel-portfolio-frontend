{{!-- Author: Rasel Al Mamun --}}
{{!-- Profile links (FD-22, FD-118): icon, label, ↗; each opens in a new tab (FD-76) and says so to
screen readers. Contact page. --}}
<ul class="list-unstyled profile-links mb-0"{{#if labelledby}} aria-labelledby="{{labelledby}}"{{/if}}>
  {{#each links}}
  <li><a class="profile-link" href="{{url}}" target="_blank" rel="me noopener noreferrer">{{> icons/footer-icon name=id}}<span class="link">{{label}}</span><span class="visually-hidden"> (opens in a new tab)</span><svg class="icon profile-external" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false"><path d="M7 17L17 7M9 7h8v8" /></svg></a></li>
  {{/each}}
</ul>
