{{!-- Blog empty state (FD-36): shown only when no post is built at all; a category without posts has
its own empty state in blog.html (FD-154). --}}
{{#unless hidden}}
<div class="empty-state" data-blog-empty>
  <p class="mb-0">{{blogPage.empty}}</p>
  <a class="profile-link" href="/portfolio.html#publications"><span class="link">See the publications</span></a>
</div>
{{/unless}}
