{{!-- Author: Rasel Al Mamun --}}
{{!-- In-house line icons of the Areas-of-work grid (FD-84): 24 px box, 1.5 px stroke in
currentColor, rounded caps (.icon). Decorative: the item's text names the area.
Usage: {{> icons/area-icon name=icon}} with one of sprout, network, camera, tractor, code, document. --}}
<svg
  class="icon area-icon"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  aria-hidden="true"
  focusable="false"
>
  {{#if (eq name "sprout")}}
  <path d="M12 20v-8M12 12c0-3.6-2.4-6-6-6 0 3.6 2.4 6 6 6zM12 10c0-3.2 2.2-5.5 6-5.5 0 3.2-2.2 5.5-6 5.5zM7 20h10" />
  {{else if (eq name "network")}}
  <path d="M10.8 7.3l-4.6 8.4M13.2 7.3l4.6 8.4M7.5 18h9" />
  <circle cx="12" cy="5" r="2.5" />
  <circle cx="5" cy="18" r="2.5" />
  <circle cx="19" cy="18" r="2.5" />
  {{else if (eq name "camera")}}
  <path d="M3 8h4l2-3h6l2 3h4v11H3z" />
  <circle cx="12" cy="13" r="3.5" />
  {{else if (eq name "tractor")}}
  <path d="M5 12V5h5l2 7h7.5l1 3M15.5 12V8M11 17h4.5" />
  <circle cx="7" cy="16" r="4" />
  <circle cx="18" cy="17.5" r="2.5" />
  {{else if (eq name "code")}}
  <path d="M8 7l-5 5 5 5M16 7l5 5-5 5M14 5l-4 14" />
  {{else if (eq name "document")}}
  <path d="M6 3h8l4 4v14H6zM14 3v4h4M9 12h6M9 16h6" />
  {{/if}}
</svg>
