{{!-- Author: Rasel Al Mamun --}}
{{!-- Project status (FD-110): the label always present, colour never the only
signal. "In progress": an --info dot and text; "Done": a --success tick and text. No border. --}}
{{#if (eq status "in-progress")}}
<span class="status status-progress"><span class="dot" aria-hidden="true"></span>In progress</span>
{{else if (eq status "done")}}
<span class="status status-done"><svg class="icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path d="M5 12l4 4L19 6" /></svg>Done</span>
{{/if}}
