{{!-- Author: Rasel Al Mamun --}}
{{!-- Theme button (FD-12, FD-17; one component for the footer and the mobile menu, 1.6.0 S3): the
moon (dark) or sun (light) icon and a label. `state` shows the current state ("Dark" / "Light",
theme.js keeps it in step) instead of the word "Theme". The accessible name carries the state
("Theme: dark") and contains the visible text. `class` adds a placement class. --}}
<button type="button" class="btn btn-secondary theme-button js-only{{#if class}} {{class}}{{/if}}" data-theme-toggle aria-label="Theme: dark"><svg class="icon icon-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg><svg class="icon icon-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>{{#if state}}<span data-theme-state>Dark</span>{{else}}Theme{{/if}}</button>
