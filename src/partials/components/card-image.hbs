{{!-- Author: Rasel Al Mamun --}}
{{!-- The card image of a project or post (1.7.0): 1600 × 900, WebP + AVIF, explicit size. Parameters:
image (the card_image record), sizes (the rendered width), decorative (a card: its link already names
it, so alt is empty; the page top keeps the alt text) and eager (the page-top image, the LCP).
The frame is .blog-cover (16:9, object-fit: cover, centred), so the subject sits in the centre band. --}}
<picture>
  {{#if image.avif}}<source type="image/avif" srcset="{{image.avif}}" sizes="{{sizes}}" />{{/if}}
  <img src="{{image.src}}" alt="{{#unless decorative}}{{image.alt}}{{/unless}}" width="{{image.width}}" height="{{image.height}}" loading="{{#if eager}}eager{{else}}lazy{{/if}}"{{#if eager}} fetchpriority="high"{{/if}} decoding="async" />
</picture>
