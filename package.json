{
  "name": "rasel-portfolio-frontend",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "description": "Static multi-page frontend of Md Rasel Al Mamun's portfolio and blog.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "tokens": "node tools/tokens.mjs",
    "content:check": "node tools/validate-content.mjs",
    "privacy:check": "node tools/check-privacy.mjs",
    "predev": "npm run tokens",
    "dev": "vite",
    "prebuild": "npm run tokens && npm run content:check",
    "build": "vite build",
    "prebuild:django": "npm run prebuild",
    "build:django": "vite build --mode django",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0 && stylelint \"src/**/*.scss\" --max-warnings 0 && prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .prettierignore.local",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .prettierignore.local",
    "pretest": "npm run build && npm run build:django",
    "test": "node tools/check-csp.mjs && node tools/check-privacy.mjs && node tools/check-django-build.mjs && npm run validate:html && playwright test tests/content.spec.js tests/pages.spec.js tests/a11y.spec.js tests/shell.spec.js tests/portfolio.spec.js tests/blog.spec.js tests/forms.spec.js tests/forms-live.spec.js tests/home.spec.js tests/stage.spec.js tests/motion.spec.js tests/inner-pages.spec.js tests/release.spec.js",
    "pretest:widths": "npm run build",
    "test:widths": "playwright test tests/widths.spec.js",
    "test:django": "node tools/test-django.mjs",
    "test:linux": "node tools/test-linux.mjs",
    "validate:html": "html-validate \"dist/**/*.html\"",
    "prelhci": "npm run build",
    "lhci": "node tools/lhci.mjs",
    "check:links": "node tools/check-links.mjs",
    "check:audit": "node tools/check-audit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "bootstrap": "5.3.8",
    "gsap": "3.15.0",
    "lenis": "1.3.27"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "html-validate": "11.17.0",
    "marked": "18.1.2",
    "prettier": "3.9.10",
    "sass": "1.106.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "subset-font": "2.9.0",
    "vite": "8.3.5",
    "vite-plugin-handlebars": "2.0.3"
  },
  "overrides": {
    "basic-ftp": "6.2.3",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "puppeteer-core": {
      "@puppeteer/browsers": "3.2.6"
    }
  },
  "author": "Rasel Al Mamun"
}
